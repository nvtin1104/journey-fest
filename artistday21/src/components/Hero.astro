---
import { Picture } from 'astro:assets';
import { ArrowRight, Hourglass, Navigation } from '@lucide/astro';
import poster from '../assets/img/poster-hero.jpg';
import { EVENT, directionsUrl } from '../data/event';
import Cloud from './deco/Cloud.astro';
import Leaf from './deco/Leaf.astro';
import Sparkle from './deco/Sparkle.astro';
import Logo from './Logo.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__sky" aria-hidden="true">
    <span class="sun"></span>
    <Cloud class="c c1" data-speed="0.35" />
    <Cloud class="c c2" data-speed="0.6" />
    <Cloud class="c c3" data-speed="0.2" />
    <Cloud class="c c4" data-speed="0.5" />
    <Cloud class="c c5 drift" />
    <Leaf class="lf lf1" tone="mint" />
    <Leaf class="lf lf2" />
    <Leaf class="lf lf3" tone="deep" />
    <Leaf class="lf lf4" tone="mint" />
    <Sparkle class="sp sp1" />
    <Sparkle class="sp sp2" />
    <Sparkle class="sp sp3" />
  </div>

  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="ribbon intro" style="--d:.05s">Miễn phí tham dự</p>

      <div class="hero__logo intro" style="--d:.15s" aria-hidden="true">
        <Logo size="lg" />
      </div>

      <h1 id="hero-title" class="hero__title">
        <span class="sr-only">Artist Day 21: </span>
        <span class="wordmark-wrap intro intro--pop" style="--d:.35s">
          <span class="wordmark" data-text="Wasteland">Wasteland</span>
        </span>
      </h1>

      <p class="hero__tag intro" style="--d:.5s">
        Ngày hội họa sĩ <strong>lớn nhất miền Nam 2026</strong> — khi nghệ thuật hồi sinh sự sống. Lạc vào vùng đất
        “tận thế” nơi phế liệu hoá kiệt tác.
      </p>

      <div class="hero__board wood intro intro--swing" style="--d:.6s">
        <Hourglass class="board__icon" aria-hidden="true" />
        <p>
          <time datetime={EVENT.start}><span class="board__date">{EVENT.dateLabel}</span></time>
          <span class="board__time">{EVENT.weekday} · {EVENT.timeLabel}</span>
        </p>
      </div>

      <div class="countdown intro" style="--d:.75s" data-countdown data-start={EVENT.start} data-end={EVENT.end}>
        <p class="countdown__label">Đếm ngược tới ngày hội</p>
        <div class="countdown__grid" role="timer" aria-label="Thời gian còn lại tới Artist Day 21">
          <div><span data-unit="d">--</span><small>Ngày</small></div>
          <div><span data-unit="h">--</span><small>Giờ</small></div>
          <div><span data-unit="m">--</span><small>Phút</small></div>
          <div><span data-unit="s">--</span><small>Giây</small></div>
        </div>
        <p class="countdown__msg" data-countdown-msg hidden></p>
      </div>

      <div class="hero__actions intro" style="--d:.9s">
        <a class="btn" href={directionsUrl} target="_blank" rel="noopener">
          <Navigation aria-hidden="true" /> Chỉ đường
        </a>
        <a class="btn btn--white" href="#hoat-dong">
          Khám phá hoạt động <ArrowRight aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="hero__art" data-tilt>
      <div class="art-card intro" style="--d:.45s">
        <Picture
          src={poster}
          formats={['avif', 'webp']}
          widths={[320, 512]}
          sizes="(min-width: 1024px) 460px, 86vw"
          alt="Poster Artist Day 21 Wasteland: chú mèo đội mũ cầm bản đồ ngồi trên cây xanh mọc từ đèn giao thông, cùng danh sách hoạt động"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>

  <svg class="hills" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 90C160 40 300 30 470 70s320 70 520 20 300-70 450-40v110H0Z" fill="#8fe39b"></path>
    <path d="M0 120c180-40 360-50 560-20s380 40 560 0 260-30 320-20v80H0Z" fill="#4cbf5d"></path>
  </svg>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: calc(var(--nav-h) + 20px);
    padding-bottom: clamp(90px, 14vw, 170px);
    background: linear-gradient(180deg, #2f9cef 0%, #63bdf7 32%, #a9dcff 68%, #dff3ff 100%);
  }

  /* Sky decorations */
  .hero__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .sun {
    position: absolute;
    top: -120px;
    right: -100px;
    width: 340px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 244 190 / 0.95), rgb(255 230 140 / 0.25) 55%, transparent 70%);
  }

  .hero__sky :global(.c) {
    position: absolute;
    height: auto;
  }

  .hero__sky :global(.c1) {
    width: 210px;
    top: 14%;
    left: -60px;
    opacity: 0.95;
  }

  .hero__sky :global(.c2) {
    width: 280px;
    top: 46%;
    right: -110px;
  }

  .hero__sky :global(.c3) {
    width: 150px;
    top: 7%;
    right: 18%;
    opacity: 0.75;
  }

  .hero__sky :global(.c4) {
    width: 240px;
    bottom: 12%;
    left: 8%;
    opacity: 0.85;
  }

  .hero__sky :global(.c5) {
    width: 120px;
    top: 30%;
    left: 0;
    opacity: 0.6;
  }

  .hero__sky :global(.drift) {
    animation: drift 46s linear infinite;
  }

  .hero__sky :global(.lf) {
    position: absolute;
    animation: sway 6s ease-in-out infinite;
  }

  .hero__sky :global(.lf1) {
    width: 44px;
    top: 18%;
    right: 12%;
    --r: -20deg;
  }

  .hero__sky :global(.lf2) {
    width: 64px;
    top: 58%;
    left: 4%;
    --r: 30deg;
    animation-delay: -2s;
    filter: blur(1.5px);
  }

  .hero__sky :global(.lf3) {
    width: 36px;
    bottom: 26%;
    right: 6%;
    --r: 120deg;
    animation-delay: -4s;
  }

  .hero__sky :global(.lf4) {
    width: 90px;
    top: 4%;
    left: 38%;
    --r: 60deg;
    filter: blur(3px);
    opacity: 0.7;
    animation-duration: 9s;
  }

  .hero__sky :global(.sp) {
    position: absolute;
  }

  .hero__sky :global(.sp1) {
    width: 30px;
    top: 22%;
    left: 8%;
  }

  .hero__sky :global(.sp2) {
    width: 20px;
    top: 38%;
    right: 8%;
    animation-delay: -0.8s;
  }

  .hero__sky :global(.sp3) {
    width: 26px;
    bottom: 30%;
    left: 46%;
    animation-delay: -1.6s;
  }

  /* Layout */
  .hero__inner {
    position: relative;
    display: grid;
    gap: 40px;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ribbon {
    position: relative;
    padding: 8px 26px;
    background: var(--coral);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 100% 0, 94% 50%, 100% 100%, 0 100%, 6% 50%);
    filter: drop-shadow(3px 4px 0 var(--coral-deep));
    rotate: -4deg;
  }

  .hero__logo {
    margin-top: 18px;
  }

  .hero__title {
    margin-top: 6px;
    line-height: 1;
  }

  /* Gradient wordmark with a thick white sticker outline underneath.
     The wrapper owns the stacking context so the outline (::before, z -1) stays behind the gradient text. */
  .wordmark-wrap {
    display: inline-block;
    isolation: isolate;
  }

  .wordmark {
    position: relative;
    display: inline-block;
    font-size: clamp(3.3rem, 16vw, 8.2rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: transparent;
    background: linear-gradient(180deg, #e6fff0 0%, #a8f0c6 30%, #5fd39b 62%, #2aa8b8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    padding: 0.04em 0.08em 0;
  }

  .wordmark::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    padding: inherit;
    color: var(--white);
    -webkit-text-stroke: 0.16em var(--white);
    text-shadow:
      0.04em 0.07em 0 #1f6f8b,
      0.06em 0.1em 0 rgb(31 58 77 / 0.35);
  }

  .hero__tag {
    max-width: 34ch;
    margin-top: 14px;
    color: #0f3550;
    font-size: 1.05em;
    text-wrap: balance;
  }

  .hero__board {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 26px;
    padding: 12px 22px;
    text-align: left;
  }

  .hero__board p {
    display: flex;
    flex-direction: column;
  }

  .board__icon {
    width: 34px;
    height: 34px;
    color: var(--leaf-deep);
    stroke-width: 2.5;
  }

  .board__date {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.9rem, 8vw, 2.6rem);
    line-height: 1;
    color: var(--teal-ink);
  }

  .board__time {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--bark);
  }

  /* Countdown */
  .countdown {
    margin-top: 24px;
  }

  .countdown__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0f3550;
  }

  .countdown__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-top: 8px;
  }

  .countdown__grid[hidden] {
    display: none;
  }

  .countdown__grid div {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 66px;
    padding: 8px 6px 6px;
    border: var(--border);
    border-radius: 16px;
    background: rgb(255 255 255 / 0.9);
    box-shadow: 3px 4px 0 var(--ink);
  }

  .countdown__grid span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 7vw, 2.2rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .countdown__grid small {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .countdown__msg {
    margin-top: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  /* Poster card */
  .hero__art {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
  }

  .art-card {
    padding: 10px;
    background: var(--white);
    border: var(--border);
    border-radius: 28px;
    box-shadow: 8px 10px 0 var(--ink);
    rotate: -3deg;
  }

  .art-card :global(img) {
    width: 100%;
    border-radius: 20px;
  }


  .hills {
    position: absolute;
    inset: auto 0 -1px;
    width: 100%;
    height: clamp(70px, 10vw, 150px);
    z-index: 1;
  }

  /* Intro (CSS-only so the hero never waits on JS). */
  .intro {
    animation: intro-rise 0.8s var(--ease-pop) both;
    animation-delay: var(--d, 0s);
  }

  .intro--pop {
    animation-name: intro-pop;
  }

  .intro--swing {
    transform-origin: 50% -30px;
    animation-name: intro-swing;
    animation-duration: 1.1s;
  }

  .art-card.intro {
    animation:
      intro-rise 0.9s var(--ease-pop) var(--d) both,
      float 6s ease-in-out 1.4s infinite;
  }

  @keyframes intro-rise {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }

  @keyframes intro-pop {
    0% {
      opacity: 0;
      transform: scale(0.4) rotate(-6deg);
    }
    60% {
      opacity: 1;
      transform: scale(1.08) rotate(2deg);
    }
  }

  @keyframes intro-swing {
    0% {
      opacity: 0;
      transform: rotate(-14deg) translateY(-30px);
    }
    45% {
      opacity: 1;
      transform: rotate(8deg);
    }
    70% {
      transform: rotate(-4deg);
    }
  }


  @media (min-width: 1024px) {
    .hero {
      min-height: 100svh;
      display: flex;
      align-items: center;
      padding-top: calc(76px + 30px);
    }

    .hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 56px;
    }

    .hero__copy {
      align-items: flex-start;
      text-align: left;
    }

    .hero__logo {
      margin-left: -6px;
    }

    .hero__actions {
      justify-content: flex-start;
    }

    .hero__art {
      width: 100%;
      max-width: 460px;
    }
  }
</style>
