---
import { Image } from 'astro:assets';
import { Brush, Hand, Music, Recycle, Sparkles, Star, Store, WalletCards } from '@lucide/astro';
import ocImg from '../assets/img/oc-trading.jpg';
import { ACTIVITIES } from '../data/event';
import Cloud from './deco/Cloud.astro';

const icons = {
  store: Store,
  recycle: Recycle,
  brush: Brush,
  sparkles: Sparkles,
  star: Star,
  cards: WalletCards,
  hand: Hand,
  music: Music,
};
---

<section class="acts section" id="hoat-dong" aria-labelledby="acts-title">
  <Cloud class="acts__cloud acts__cloud--1" data-speed="0.3" />
  <Cloud class="acts__cloud acts__cloud--2" data-speed="0.5" />

  <div class="container">
    <header class="acts__head">
      <span class="eyebrow" data-reveal>♻ 8 điểm check-in</span>
      <h2 id="acts-title" class="section-title" data-reveal>Có gì ở vùng đất Wasteland?</h2>
      <p class="section-lead" data-reveal>
        Từ chợ phiên tới sân khấu live — mỗi góc là một trạm “tái sinh” đầy màu sắc. Đi một vòng là đủ đầy túi goods, đầy
        bộ nhớ ảnh và đầy năng lượng.
      </p>
    </header>

    <ol class="grid" data-stagger>
      {
        ACTIVITIES.map((a, i) => {
          const Icon = icons[a.icon];
          const featured = a.id === 'oc-trading';
          return (
            <li class:list={['card', `tone-${a.tone}`, { 'card--featured': featured, 'card--wide': a.id === 'music' }]} id={a.id}>
              {featured && (
                <div class="card__media">
                  <Image
                    src={ocImg}
                    widths={[360, 526]}
                    sizes="(min-width: 1024px) 520px, 92vw"
                    alt="Khu Original Character Trading: các bạn trẻ trao đổi thẻ và goods OC tại Artist Day"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="card__body">
                <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="card__icon">
                  <Icon aria-hidden="true" />
                </span>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .acts {
    overflow: hidden;
    background: linear-gradient(180deg, var(--cream), var(--sky-mist) 30%, #d4efff);
  }

  .acts :global(.acts__cloud) {
    position: absolute;
    width: 260px;
    opacity: 0.8;
  }

  .acts :global(.acts__cloud--1) {
    top: 80px;
    right: -90px;
  }

  .acts :global(.acts__cloud--2) {
    bottom: 60px;
    left: -100px;
    width: 320px;
  }

  .acts__head {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .grid {
    position: relative;
    display: grid;
    gap: 18px;
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    --tone: var(--mint);
    --tone-strong: var(--leaf-deep);
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sticker);
    transition:
      transform 0.35s var(--ease-pop),
      box-shadow 0.35s ease;
  }

  .tone-leaf {
    --tone: #c9f2cf;
    --tone-strong: var(--leaf-deep);
  }
  .tone-mint {
    --tone: #c8f5e4;
    --tone-strong: #109477;
  }
  .tone-sky {
    --tone: #cbe9ff;
    --tone-strong: var(--sky-deep);
  }
  .tone-sun {
    --tone: var(--sun-soft);
    --tone-strong: #c48a00;
  }
  .tone-coral {
    --tone: #ffd5dc;
    --tone-strong: var(--coral-deep);
  }
  .tone-lilac {
    --tone: #e5dcff;
    --tone-strong: #6a46e0;
  }

  .card__body {
    position: relative;
    flex: 1;
    padding: 22px 20px 24px;
    background: linear-gradient(160deg, var(--tone) 0 46%, var(--white) 46%);
  }

  .card__num {
    position: absolute;
    top: 14px;
    right: 18px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--tone-strong);
    opacity: 0.45;
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: var(--border);
    border-radius: 16px;
    background: var(--white);
    color: var(--tone-strong);
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 0.4s var(--ease-pop);
  }

  .card__icon :global(svg) {
    width: 26px;
    height: 26px;
    stroke-width: 2.2;
  }

  .card h3 {
    margin-top: 16px;
    font-size: 1.45rem;
  }

  .card p {
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: 0.97rem;
  }

  .card__media {
    border-bottom: var(--border);
    background: var(--tone);
  }

  .card__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 50% 30%;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translate(-3px, -4px) rotate(-0.6deg);
      box-shadow: 9px 10px 0 var(--ink);
    }

    .card:hover .card__icon {
      transform: rotate(-10deg) scale(1.12);
    }
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .card--featured,
    .card--wide {
      grid-column: 1 / -1;
    }

    .card--featured .card__media :global(img) {
      aspect-ratio: 21 / 9;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }

    .card--featured {
      grid-column: span 2;
      grid-row: span 2;
    }

    .card--wide {
      grid-column: span 2;
    }

    .card--featured .card__media {
      flex: 1;
    }

    .card--featured .card__media :global(img) {
      height: 100%;
      aspect-ratio: auto;
      min-height: 260px;
    }

    .card--featured .card__body {
      flex: none;
    }
  }
</style>
