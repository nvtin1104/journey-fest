---
import { Download, Navigation } from '@lucide/astro';
import { EVENT, directionsUrl } from '../data/event';
---

<div class="bar" data-bar>
  <a class="btn btn--leaf" href={directionsUrl} target="_blank" rel="noopener">
    <Navigation aria-hidden="true" /> Chỉ đường
  </a>
  <a class="btn btn--sun" href={EVENT.frameUrl} target="_blank" rel="noopener">
    <Download aria-hidden="true" /> Tải frame
  </a>
</div>

<style>
  .bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: rgb(255 249 236 / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: var(--border);
    transform: translateY(110%);
    transition: transform 0.4s var(--ease-pop);
  }

  .bar.is-visible {
    transform: none;
  }

  .bar .btn {
    min-height: 48px;
    padding-inline: 12px;
    font-size: 1rem;
  }

  @media (min-width: 768px) {
    .bar {
      display: none;
    }
  }
</style>
