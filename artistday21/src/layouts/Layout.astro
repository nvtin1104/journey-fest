---
import { getImage } from 'astro:assets';
import banner from '../assets/img/banner-wide.jpg';
import poster from '../assets/img/poster-hero.jpg';
import { DESCRIPTION, EVENT, FAQ, fullAddress } from '../data/event';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = DESCRIPTION } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;

// Social previews need absolute, crawler-friendly JPEGs.
const og = await getImage({ src: banner, format: 'jpg', width: 1200, quality: 85 });
const ogPoster = await getImage({ src: poster, format: 'jpg', quality: 85 });
const ogUrl = new URL(og.src, site).href;
const posterUrl = new URL(ogPoster.src, site).href;

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${EVENT.name} – Ngày hội họa sĩ`,
  description,
  startDate: EVENT.start,
  endDate: EVENT.end,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  isAccessibleForFree: true,
  inLanguage: 'vi',
  image: [ogUrl, posterUrl],
  url: canonical,
  location: {
    '@type': 'Place',
    name: `${EVENT.venue} – ${EVENT.spot}`,
    address: {
      '@type': 'PostalAddress',
      streetAddress: EVENT.street,
      addressLocality: EVENT.ward,
      addressRegion: EVENT.city,
      addressCountry: 'VN',
    },
  },
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'VND',
    availability: 'https://schema.org/InStock',
    url: canonical,
    validFrom: '2026-10-01T00:00:00+07:00',
  },
  organizer: { '@type': 'Organization', name: EVENT.organizer, url: EVENT.facebook },
  performer: { '@type': 'PerformingGroup', name: 'Artist Day Vietnam – họa sĩ & khách mời' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Artist Day Vietnam',
  url: site.href,
  sameAs: [EVENT.facebook],
};
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#3fa9f5" />
    <meta name="keywords" content="Artist Day 21, Wasteland, ngày hội họa sĩ, AD21, AEON MALL Tân Phú Celadon, artist market, cosplay, OC trading, sự kiện TP.HCM 2026" />
    <meta name="author" content={EVENT.organizer} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Artist Day Vietnam" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(og.attributes.width)} />
    <meta property="og:image:height" content={String(og.attributes.height)} />
    <meta property="og:image:alt" content="Key visual Artist Day 21: Wasteland – 08.11.2026 tại AEON MALL Tân Phú Celadon" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="geo.region" content="VN-SG" />
    <meta name="geo.placename" content={fullAddress} />

    <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Bỏ qua tới nội dung</a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
